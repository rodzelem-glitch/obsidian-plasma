{
  "hosting": {
    "site": "tektrakker-marketing",
    "public": "out",
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "redirects": [
      {
        "source": "/hiring-widget.js",
        "destination": "https://app.tektrakker.com/hiring-widget.js",
        "type": 301
      },
      {
        "source": "/widget.js",
        "destination": "https://app.tektrakker.com/widget.js",
        "type": 301
      },
      {
        "source": "/p/:slug*",
        "destination": "https://app.tektrakker.com/#/p/:slug*",
        "type": 301
      },
      {
        "source": "/p",
        "destination": "https://app.tektrakker.com/#/p",
        "type": 301
      },
      {
        "source": "/site/:orgId*",
        "destination": "https://app.tektrakker.com/#/site/:orgId*",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|svg|json|webp|woff2|mp4)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
