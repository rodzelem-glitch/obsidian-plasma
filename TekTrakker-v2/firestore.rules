    match /documents/{docId} {
      allow get: if !isPlatformSales() 
                 || (isPlatformSales() && (resource.data.userId == request.auth.uid || resource.data.createdBy == request.auth.uid));
      allow list: if isMaster() 
                  || (isPlatformSales() && (resource.data.userId == request.auth.uid || resource.data.createdBy == request.auth.uid))
                  || (isOrgMember(resource.data.organizationId) && !isPlatformSales()) 
                  || isCustomerOwner(resource.data);
      allow update, delete: if isMaster() 
                    || (isPlatformSales() && (resource.data.userId == request.auth.uid || resource.data.createdBy == request.auth.uid))
                    || (isOrgMember(resource.data.organizationId) && !isPlatformSales()) 
                    || isCustomerOwner(resource.data) 
                    || (isSignedIn() && request.resource.data.status == 'Signed');
      allow create: if isMaster() 
                    || (isPlatformSales() && request.resource.data.organizationId == 'platform' && (request.resource.data.userId == request.auth.uid || request.resource.data.createdBy == request.auth.uid))
                    || (isOrgMember(request.resource.data.organizationId) && !isPlatformSales()) 
                    || isCustomer()
                    || (isSignedIn() && request.resource.data.type == 'Agreement' && (request.resource.data.subcontractorId == request.auth.uid || (request.auth.token.email != null && request.resource.data.subcontractorEmail == request.auth.token.email)));
    }

