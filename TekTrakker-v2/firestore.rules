                  || (isPlatformSales() && (resource == null || resource.data.repId == request.auth.uid) && (request.resource == null || request.resource.data.repId == request.auth.uid));
    }

    // Platform Campaign Studio: saved email templates (master admin + platform sales)
    match /platform_campaign_templates/{templateId} {
