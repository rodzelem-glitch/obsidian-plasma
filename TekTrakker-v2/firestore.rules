
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return request.auth == null ? null : (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
          : null
      );
    }

    function isTerminalJobState(jobData) {
      return jobData != null && (
        jobData.get('jobStatus', '') == 'Cancelled' ||
        jobData.get('jobStatus', '') == 'Completed' ||
        jobData.get('invoiceStatus', '') == 'Paid' ||
        jobData.get('invoiceStatus', '') == 'Closed' ||
        (jobData.get('invoice', null) != null && 
         (jobData.get('invoice', {}).get('status', '') == 'Paid' || jobData.get('invoice', {}).get('status', '') == 'Closed'))
      );
    }

    // ROBUST ORG CHECK: Prioritize token claims (fast), fallback to simple UID check
    function isOrgMember(resourceOrgId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let isDirectMember = isSignedIn() && (
        (request.auth.token.organizationId != null && request.auth.token.organizationId == resourceOrgId) ||
        (exists(userPath) && get(userPath).data.get('organizationId', '') == resourceOrgId) ||
        (request.auth.token.email != null && 
         exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('organizationId', '') == resourceOrgId)
      );
      return isDirectMember || isMaster() || isPlatformSales() || isOrgFranchiseAdmin(resourceOrgId);
    }

    function isDirectOrgMember(resourceOrgId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && (
        (request.auth.token.organizationId != null && request.auth.token.organizationId == resourceOrgId) ||
        (exists(userPath) && get(userPath).data.get('organizationId', '') == resourceOrgId) ||
        (request.auth.token.email != null && 
         exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('organizationId', '') == resourceOrgId)
      );
    }

    function isDirectAssignedPartner(jobData) {
      return isSignedIn() && 
             jobData.assignedPartnerId != null &&
             isDirectOrgMember(jobData.assignedPartnerId);
    }

    function isSubcontractor() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'Subcontractor' ||
        (exists(userPath) && get(userPath).data.get('role', '') == 'Subcontractor')
      );
    }

    function isAssignedSubcontractor(jobData) {
      return isSubcontractor() && (
        jobData.get('assignedTechnicianId', '') == request.auth.uid ||
        jobData.get('assistants', []).hasAny([request.auth.uid]) ||
        jobData.get('assignedCrew', []).hasAny([request.auth.uid]) ||
        (jobData.get('subcontractorId', null) != null && jobData.get('subcontractorId', null) == request.auth.uid) ||
        (jobData.get('subcontractorEmail', null) != null && request.auth.token.email != null && jobData.get('subcontractorEmail', null) == request.auth.token.email)
      );
    }
    
    function isFranchiseAdmin(docFranchiseId) {
      let userData = getUserData();
      return isSignedIn() && userData != null && userData.get('role', '') == 'franchise_admin' && docFranchiseId != null && userData.get('franchiseId', 'X') == docFranchiseId;
    }

    function isOrgFranchiseAdmin(orgId) {
      let orgPath = /databases/$(database)/documents/organizations/$(orgId);
      let orgData = exists(orgPath) ? get(orgPath).data : {};
      return exists(orgPath) && isFranchiseAdmin(orgData.get('franchiseId', 'X'));
    }
    
    // Checks if user is an admin (UID or Email keyed)
    function isOrgAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') in ['admin', 'master_admin', 'both', 'supervisor', 'Admin', 'Master_Admin', 'Both', 'Supervisor'] ||
        (
          request.auth.uid != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'master_admin', 'both', 'supervisor', 'Admin', 'Master_Admin', 'Both', 'Supervisor']
        ) ||
        (
          request.auth.token.email != null && exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('role', '') in ['admin', 'master_admin', 'both', 'supervisor', 'Admin', 'Master_Admin', 'Both', 'Supervisor']
        )
      );
    }

    function isMaster() {
      return request.auth != null && (
        request.auth.token.get('role', '') == 'master_admin' || 
        request.auth.token.get('role', '') == 'both' ||
        (getUserData() != null && (getUserData().get('role', '') == 'master_admin' || getUserData().get('role', '') == 'both'))
      );
    }
    
    // Checks if user is a Platform Sales Rep
    function isPlatformSales() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'platform_sales' ||
        (getUserData() != null && getUserData().get('role', '') == 'platform_sales')
      );
    }

    // Checks if user is a customer (UID or Email keyed)
    function isCustomer() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'customer' ||
        (
          request.auth.uid != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'customer'
        ) ||
        (
          request.auth.token.email != null && exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
          get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('role', '') == 'customer'
        )
      );
    }

    function isCustomerContactOf(customerId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && 
             get(userPath).data.get('customerId', '') == customerId;
    }

    // Checks if the user is the customer assigned to this document
    function isCustomerOwner(resourceData) {
      // Direct UID match (for Doc ID) or field match
      return isSignedIn() && resourceData != null && (
        (resourceData.get('userId', null) != null && resourceData.get('userId', null) == request.auth.uid) ||
        (resourceData.get('customerId', null) != null && (resourceData.get('customerId', null) == request.auth.uid || isCustomerContactOf(resourceData.get('customerId', null)))) ||
        (resourceData.get('email', null) != null && request.auth.token.email != null && resourceData.get('email', null) == request.auth.token.email) ||
        (resourceData.get('customerEmail', null) != null && request.auth.token.email != null && resourceData.get('customerEmail', null) == request.auth.token.email) ||
        (resourceData.get('id', null) != null && (resourceData.get('id', null) == request.auth.uid || isCustomerContactOf(resourceData.get('id', null)))) ||
        (resourceData.get('subcontractorId', null) != null && resourceData.get('subcontractorId', null) == request.auth.uid) ||
        (resourceData.get('subcontractorEmail', null) != null && request.auth.token.email != null && resourceData.get('subcontractorEmail', null) == request.auth.token.email)
      );
    }

    // Check if the user's organization is the assigned partner for the job
    function isAssignedPartner(resourceData) {
      return isSignedIn() && 
             resourceData.get('assignedPartnerId', null) != null &&
             isOrgMember(resourceData.get('assignedPartnerId', null));
    }
    
    // --- Core Collections ---

    match /users/{userId} {
      allow get: if isSignedIn();
                 
      allow list: if isMaster() || isPlatformSales() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || (resource != null && isOrgMember(resource.data.organizationId)) || (isSignedIn() && resource != null && resource.data.email != null && request.auth.token.email != null && resource.data.email == request.auth.token.email); 
      
      allow write: if isMaster() 
                 || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) 
                 || isUser(userId) 
                 || (isOrgAdmin() && resource != null && isOrgMember(resource.data.organizationId)) 
                 || (isSignedIn() && request.auth.token.email != null && request.auth.token.email == userId)
                 || (isSubcontractor() && resource != null && resource.data.get('subcontractorId', '') == request.auth.uid)
                 || (isPlatformSales() && (
                      isUser(userId)
                       || (resource != null && resource.data.get('organizationId', '') != 'platform' && (
                            resource.data.get('role', '') == 'customer' 
                            || resource.data.get('role', '') == 'both' 
                            || resource.data.get('role', '') == 'admin'
                          ))
                     ));
      allow create: if isSignedIn();

      match /private/sensitive {
        allow read, write: if isUser(userId) || isOrgAdmin() || isMaster();
      }
    }

    // Organizations: Public read for login/branding, Admin write only.
    match /organizations/{orgId} {
      allow read: if true; 
      allow create: if isSignedIn();
      allow update: if isMaster() || isPlatformSales() || (isOrgMember(orgId) && isOrgAdmin()) || (isOrgMember(orgId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextProposalNum', 'nextInvoiceNum']));
      allow delete: if isMaster() || isPlatformSales() || (isOrgMember(orgId) && isOrgAdmin());
      
      match /secrets/{secretId} {
         allow read, write: if isMaster() || isPlatformSales() || (isOrgMember(orgId) && isOrgAdmin());
      }

      match /payouts/{payoutId} {
         allow read, write: if isMaster() || isOrgMember(orgId);
      }

      match /disputes/{disputeId} {
         allow read, write: if isMaster() || isOrgMember(orgId);
      }

      match /marketingTemplates/{templateId} {
         allow read, write: if isMaster() || isPlatformSales() || (isOrgMember(orgId) && isOrgAdmin());
      }

      match /socialMediaTemplates/{templateId} {
         allow read, write: if isMaster() || isPlatformSales() || isOrgMember(orgId);
      }

      match /socialMediaPosts/{postId} {
         allow read, write: if isMaster() || isPlatformSales() || isOrgMember(orgId);
      }
      
      match /jobs/{jobId}/ai_messages/{msgId} {
         allow read, write: if isDirectOrgMember(orgId);
      }

      match /blogPosts/{postId} {
         allow read: if true;
         allow write: if isMaster() || isPlatformSales() || isOrgMember(orgId);
      }

      match /ai_context/{contextId} {
         allow read, write: if isMaster() || isPlatformSales() || (isOrgMember(orgId) && isOrgAdmin());
      }

      match /settings/{settingId} {
         allow read: if isMaster() || isPlatformSales() || isOrgMember(orgId);
         allow write: if isMaster() || isPlatformSales() || (isOrgMember(orgId) && isOrgAdmin());
      }

      match /warrantyClaims/{claimId} {
         allow read, write: if isMaster() || isPlatformSales() || isOrgMember(orgId);
      }

      match /aiLongTasks/{taskId} {
         allow read, write: if isDirectOrgMember(orgId);
      }

      match /aiTasks/{taskId} {
         allow read, write: if isDirectOrgMember(orgId);
      }

      match /active_calls/{callId} {
         allow read: if isMaster() || isPlatformSales() || isOrgMember(orgId);
         allow write: if isMaster() || isPlatformSales() || isOrgMember(orgId);
      }

      match /fleet_positions/{posId} {
         allow read: if isMaster() || isPlatformSales() || isOrgMember(orgId);
         allow write: if isMaster() || isPlatformSales() || isOrgMember(orgId);
      }

      match /jobs/{jobId}/companycam_photos/{photoId} {
         allow read, write: if isMaster() || isPlatformSales() || isOrgMember(orgId);
      }

      match /aiVoiceLogs/{logId} {
         allow read, write: if isDirectOrgMember(orgId);
      }

      match /synthesizedData/{docId} {
         allow read, write: if isMaster() || isPlatformSales() || isOrgMember(orgId);
      }
    }

    match /franchises/{franchiseDocId} {
       allow read: if true; // Public array access for DNS Domain mapping
       allow write: if isMaster() || isFranchiseAdmin(franchiseDocId);
    }

    // Customers: Accessible by organization members or the customer themselves.
    match /customers/{customerId} {
      allow get: if isSignedIn();
      allow read: if isMaster() || isPlatformSales() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || (resource != null && isOrgMember(resource.data.organizationId)) || (resource != null && isCustomerOwner(resource.data)) || request.auth.uid == customerId || (isSignedIn() && resource != null && resource.data.email != null && request.auth.token.email != null && resource.data.email == request.auth.token.email) || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);
      allow write: if isMaster() || (resource != null && isOrgMember(resource.data.organizationId)) || (resource != null && isCustomerOwner(resource.data)) || request.auth.uid == customerId;
      allow create: if isMaster() || (isOrgMember(request.resource.data.organizationId)) || (request.resource.data.email != null && request.auth.token.email != null && request.resource.data.email == request.auth.token.email) || request.auth.uid == customerId;

      match /communications/{commId} {
        allow read, write: if isSignedIn();
      }
    }

    match /appointments/{appointmentId} {
      allow read: if isMaster() || isPlatformSales() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || (resource != null && isOrgMember(resource.data.organizationId)) || (resource != null && isCustomerOwner(resource.data));
      allow create: if isMaster() || isOrgMember(request.resource.data.organizationId) || isCustomerOwner(request.resource.data);
      allow update: if isMaster() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || (resource != null && isOrgMember(resource.data.organizationId));
      allow delete: if resource == null || isMaster() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || (resource != null && isOrgMember(resource.data.organizationId));
    }

    match /jobs/{jobId} {
      allow get: if true;
      allow list: if isMaster() || isPlatformSales() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || isAssignedPartner(resource.data) || isCustomerOwner(resource.data);
      allow list: if isOrgMember(resource.data.organizationId) && !isSubcontractor();
      allow list: if isOrgMember(resource.data.organizationId) && isAssignedSubcontractor(resource.data);
      allow create: if isMaster() || isPlatformSales() || (isOrgMember(request.resource.data.organizationId) && !isSubcontractor());
      allow update: if isMaster() 
                    || isPlatformSales() 
                    || isOrgAdmin()
                    || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) 
                    || (resource != null && isOrgMember(resource.data.get('organizationId', '')) && !isPlatformSales() && (!isSubcontractor() || isAssignedSubcontractor(resource.data)))
                    || (request.resource != null && isOrgMember(request.resource.data.get('organizationId', '')) && !isPlatformSales() && (!isSubcontractor() || isAssignedSubcontractor(request.resource.data)))
                    || (resource != null && isAssignedPartner(resource.data))
                    || (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invoiceSignature', 'invoiceSignedDate', 'customerFeedback'])
                       )
                    || (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposalId', 'invoice', 'updatedAt']) &&
                         request.resource.data.proposalId != null &&
                         exists(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)) &&
                         get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data.get('jobId', '') == jobId
                       )
                    || (
                          isCustomerOwner(resource.data) &&
                          (
                            !isTerminalJobState(resource.data) 
                            || (
                                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invoiceSignature', 'invoiceSignedDate', 'customerFeedback', 'invoice']) &&
                                 (
                                   !request.resource.data.diff(resource.data).affectedKeys().hasAny(['invoice']) ||
                                   (
                                     resource.data.invoice == null ||
                                     (
                                       request.resource.data.invoice.diff(resource.data.invoice).affectedKeys().hasOnly(['status', 'opened', 'openedAt']) &&
                                       (
                                         !request.resource.data.invoice.diff(resource.data.invoice).affectedKeys().hasAny(['status']) ||
                                         request.resource.data.invoice.status == 'Opened'
                                       ) &&
                                       (
                                         !request.resource.data.invoice.diff(resource.data.invoice).affectedKeys().hasAny(['opened']) ||
                                         request.resource.data.invoice.opened == true
                                       )
                                     )
                                   )
                                 )
                               )
                          )
                        )
                    || (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'updatedAt', 'tempToken']) &&
                         request.resource.data.get('tempToken', '') != '' &&
                         exists(/databases/$(database)/documents/magic_links/$(request.resource.data.tempToken)) &&
                         get(/databases/$(database)/documents/magic_links/$(request.resource.data.tempToken)).data.jobId == jobId &&
                         get(/databases/$(database)/documents/magic_links/$(request.resource.data.tempToken)).data.active == true &&
                         request.time < get(/databases/$(database)/documents/magic_links/$(request.resource.data.tempToken)).data.expiresAt
                       );
      allow delete: if false;
      
      match /ai_messages/{msgId} {
        allow read, write: if isSignedIn() && (
                             isDirectOrgMember(get(/databases/$(database)/documents/jobs/$(jobId)).data.organizationId) ||
                             isDirectAssignedPartner(get(/databases/$(database)/documents/jobs/$(jobId)).data)
                           );
      }
      
      match /diagnostics/{reportId} {
         allow read: if isMaster() || isPlatformSales() || isOrgMember(get(/databases/$(database)/documents/jobs/$(jobId)).data.organizationId);
         allow write: if false; // Only written by trusted Cloud Functions (measureQuickWebhook)
      }
    }

    match /invoices/{invoiceId} {
      allow get: if true;
      allow list: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId) || isCustomerOwner(resource.data);
      allow read: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId);
      allow create, update: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId);
      allow delete: if false;
    }
    
    // Allow users to generate outbound system emails via batch write extensions
    match /mail/{mailId} {
      allow create: if isSignedIn();
    }

    match /applicants/{applicantId} {
      allow create: if true; // Public applicant submissions
      allow read, write: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId);
    }

    match /messages/{messageId} {
      allow create: if true; 
      allow read: if isMaster() || isPlatformSales() || isCustomerOwner(resource.data)
                  || (
                       isOrgMember(resource.data.organizationId) &&
                       (
                         resource.data.type in ['sms', 'email', 'customer-log'] ||
                         resource.data.receiverId in ['all', 'all_admins', 'all_sales'] ||
                         resource.data.senderId == request.auth.uid ||
                         resource.data.receiverId == request.auth.uid ||
                         (request.auth.token.email != null && (
                           resource.data.senderId == request.auth.token.email ||
                           resource.data.receiverId == request.auth.token.email
                         ))
                       )
                     );
      allow write: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId) || isCustomerOwner(resource.data);
    }

    match /inventory/{itemId} {
      allow read: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId);
      allow write: if isMaster() || isOrgMember(resource.data.organizationId);
      allow create: if isMaster() || isOrgMember(request.resource.data.organizationId);
    }

    match /expenses/{expenseId} {
      allow read: if isMaster()
                  || (isPlatformSales() && resource.data.createdById == request.auth.uid)
                  || (isOrgMember(resource.data.organizationId) && !isPlatformSales())
                  || (
                        resource.data.projectId != null &&
                        exists(/databases/$(database)/documents/jobs/$(resource.data.projectId)) &&
                        (
                          isAssignedPartner(get(/databases/$(database)/documents/jobs/$(resource.data.projectId)).data) ||
                          isAssignedSubcontractor(get(/databases/$(database)/documents/jobs/$(resource.data.projectId)).data)
                        )
                     );
      allow create: if isMaster()
                  || (isPlatformSales() && request.resource.data.createdById == request.auth.uid)
                  || (isOrgMember(request.resource.data.organizationId) && !isPlatformSales())
                  || (
                        request.resource.data.projectId != null &&
                        exists(/databases/$(database)/documents/jobs/$(request.resource.data.projectId)) &&
                        (
                          isAssignedPartner(get(/databases/$(database)/documents/jobs/$(request.resource.data.projectId)).data) ||
                          isAssignedSubcontractor(get(/databases/$(database)/documents/jobs/$(request.resource.data.projectId)).data)
                        )
                     );
      allow write: if isMaster()
                  || (isPlatformSales() && resource.data.createdById == request.auth.uid)
                  || (isOrgMember(resource.data.organizationId) && !isPlatformSales())
                  || (
                        resource.data.projectId != null &&
                        exists(/databases/$(database)/documents/jobs/$(resource.data.projectId)) &&
                        (
                          isAssignedPartner(get(/databases/$(database)/documents/jobs/$(resource.data.projectId)).data) ||
                          isAssignedSubcontractor(get(/databases/$(database)/documents/jobs/$(resource.data.projectId)).data)
                        )
                     );
    }

    match /serviceLocations/{locationId} {
      allow read: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId) || isCustomerOwner(resource.data);
      allow write: if isMaster() || isOrgMember(resource.data.organizationId) || isCustomerOwner(resource.data);
      allow create: if isMaster() || isOrgMember(request.resource.data.organizationId) || isCustomerOwner(request.resource.data);
    }

    match /equipment/{equipmentId} {
      allow read: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId) || isCustomerOwner(resource.data);
      allow write: if isMaster() || isOrgMember(resource.data.organizationId) || isCustomerOwner(resource.data);
      allow create: if isMaster() || isOrgMember(request.resource.data.organizationId) || isCustomerOwner(request.resource.data);
    }

    match /payables/{payableId} {
      allow read: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId)
                  || (
                        resource.data.jobId != null &&
                        exists(/databases/$(database)/documents/jobs/$(resource.data.jobId)) &&
                        (
                          isAssignedPartner(get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data) ||
                          isAssignedSubcontractor(get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data)
                        )
                     );
      allow create: if isMaster() || isOrgMember(request.resource.data.organizationId)
                  || (
                        request.resource.data.jobId != null &&
                        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
                        (
                          isAssignedPartner(get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data) ||
                          isAssignedSubcontractor(get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data)
                        )
                     );
      allow write: if isMaster() || isOrgMember(resource.data.organizationId)
                  || (
                        resource.data.jobId != null &&
                        exists(/databases/$(database)/documents/jobs/$(resource.data.jobId)) &&
                        (
                          isAssignedPartner(get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data) ||
                          isAssignedSubcontractor(get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data)
                        )
                     );
    }

    match /proposals/{proposalId} {
      allow read: if true; 
      allow create: if isMaster() || isPlatformSales() || isOrgMember(request.resource.data.organizationId);
      allow update: if isMaster() || isPlatformSales() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || isOrgMember(resource.data.organizationId)
                    || (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'status', 'signatureDataUrl', 'signatureName', 'signedAt', 'selectedOption', 'subtotal', 'taxAmount', 'total', 'invoiceId',
                           'ndaSigned', 'ndaSignedAt', 'ndaSignerName', 'ndaSignatureDataUrl',
                           'proposalTermsAgreed', 'proposalTermsAgreedAt', 'trackingHistory'
                         ])
                       );
      allow delete: if false;
    }
    
    match /proposalPresets/{presetId} {
      allow read: if isMaster() || isPlatformSales() || isOrgMember(resource.data.organizationId);
      allow write: if isMaster() || isOrgMember(resource.data.organizationId);
      allow create: if isMaster() || isOrgMember(request.resource.data.organizationId);
    }

    match /serviceAgreements/{agreementId} {
      allow read: if isMaster() || isPlatformSales() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || isOrgMember(resource.data.organizationId) || isCustomerOwner(resource.data);
      allow write: if isMaster() || (resource != null && isFranchiseAdmin(resource.data.get('franchiseId', null))) || isOrgMember(resource.data.organizationId);
      allow create: if isMaster() || isOrgMember(request.resource.data.organizationId) || isCustomerOwner(request.resource.data);
