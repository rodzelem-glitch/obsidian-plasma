    }

    match /whiteboards/{orgId} {
      allow read, write: if (orgId == 'platform' && request.auth != null && (request.auth.token.email == 'rodzelem@gmail.com' || request.auth.token.email == 'ryanvavrecan@gmail.com')) ||
                           (orgId != 'platform' && (isMaster() || isPlatformSales() || isOrgMember(orgId)));
